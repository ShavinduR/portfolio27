{
  "name": "shavindu-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio of W.S.R. Rathnayaka (Shavindu Rashmika) — static site, no runtime build required.",
  "scripts": {
    "build": "npm run prerender && npm run build:css",
    "build:vercel": "npm run build && node scripts/dist.mjs",
    "prerender": "node scripts/prerender.mjs",
    "build:css": "tailwindcss -i assets/css/tailwind.src.css -o assets/css/site.css --minify",
    "watch:css": "tailwindcss -i assets/css/tailwind.src.css -o assets/css/site.css --watch",
    "images": "node scripts/optimize-images.mjs && npm run build",
    "serve": "python3 -m http.server 8000",
    "icons": "python3 scripts/build-icons.py && npm run build:css"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "sharp": "^0.34.0",
    "tailwindcss": "^3.4.17"
  }
}
